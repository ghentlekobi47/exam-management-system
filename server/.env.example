PORT=5000
NODE_ENV=development
# Website address(es) allowed to use the API; separate several with commas
CLIENT_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_NAME=campusiq
DB_USER=root
DB_PASSWORD=
# Hosted databases (e.g. Aiven) need an encrypted connection:
#   DB_SSL=true and the provider's CA certificate, either pasted into DB_SSL_CA
#   (the whole text, including the BEGIN/END CERTIFICATE lines) or saved as a file in DB_SSL_CA_FILE.
DB_SSL=false
DB_SSL_CA=
DB_SSL_CA_FILE=

JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=1d

# Email for verification codes. Leave empty in development to print codes in the terminal instead.
#
# Option 1, SMTP (default). Brevo: dashboard -> SMTP & API -> SMTP tab.
#   MAIL_USER = the "Login" shown there, MAIL_PASSWORD = an SMTP key you generate.
#   Gmail instead: MAIL_HOST=smtp.gmail.com, MAIL_PORT=465, MAIL_SECURE=true, MAIL_PASSWORD = a Google app password.
# Option 2, Brevo's web API: use this on hosts that block email ports (Render's free plan).
#   MAIL_TRANSPORT=brevo-api and BREVO_API_KEY = a key from Brevo -> SMTP & API -> API Keys.
# Either way, MAIL_FROM must be a sender email you have verified in Brevo.
MAIL_TRANSPORT=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=CampusIQ
