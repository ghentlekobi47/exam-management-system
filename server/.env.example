PORT=5000
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
DB_HOST=localhost
DB_PORT=3306
DB_NAME=campusiq
DB_USER=root
DB_PASSWORD=
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=1d

# Email (SMTP) for verification codes. Leave MAIL_USER / MAIL_PASSWORD empty in
# development to print codes in the terminal instead.
#
# Brevo (default): Brevo dashboard -> SMTP & API -> SMTP tab.
#   MAIL_USER = the "Login" shown there, MAIL_PASSWORD = an SMTP key you generate,
#   MAIL_FROM = a sender email you have verified in Brevo.
# Gmail instead: MAIL_HOST=smtp.gmail.com, MAIL_PORT=465, MAIL_SECURE=true,
#   MAIL_USER/MAIL_FROM = your Gmail address, MAIL_PASSWORD = a Google app password.
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=CampusIQ
